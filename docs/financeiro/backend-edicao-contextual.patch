+package br.com.seteideias.sixback.service.caixa;
+
+import br.com.seteideias.sixback.service.UsuarioEmpresaVinculoService;
+import br.com.seteideias.sixback.service.ValidadorAcessoEmpresaDoUsuario;
+import lombok.RequiredArgsConstructor;
+import br.com.seteideias.sixback.repository.UsuarioEmpresaVinculoRepository;
+import org.springframework.http.HttpStatus;
+import org.springframework.stereotype.Service;
+import org.springframework.web.server.ResponseStatusException;
+
+@Service
+@RequiredArgsConstructor
+public class TipoRecebimentoPermissaoService {
+    // Opt-out: registros atuais e novos permanecem liberados por padrão.
+    public static final String BLOQUEAR_EDICAO = "TIPOS_RECEBIMENTO_EDITAR_NEGADO";
+    private final ValidadorAcessoEmpresaDoUsuario acesso;
+    private final UsuarioEmpresaVinculoService vinculos;
+    private final UsuarioEmpresaVinculoRepository repository;
+
+    public boolean podeEditar(String usuario, String empresa) {
+        if (repository.findByKeycloakIdAndIdUnicoDaEmpresa(usuario, empresa)
+                .map(v -> !v.estaAtivo()).orElse(false)) return false;
+        if (!acesso.possuiVinculoComEmpresa(usuario, empresa)) return false;
+        return vinculos.buscarVinculoAtivo(usuario, empresa)
+                .map(v -> v.ehAdministrador() || v.getPermissoes() == null
+                        || v.getPermissoes().stream().noneMatch(p ->
+                            p != null && BLOQUEAR_EDICAO.equalsIgnoreCase(p.trim())))
+                .orElse(true);
+    }
+
+    public void validarEdicao(String usuario, String empresa) {
+        if (!podeEditar(usuario, empresa)) {
+            throw new ResponseStatusException(HttpStatus.FORBIDDEN, "PERMISSAO_NEGADA");
+        }
+    }
+}
