+package br.com.seteideias.sixback.service.caixa;
+
+import br.com.seteideias.sixback.enums.PapelVinculoEmpresaEnum;
+import br.com.seteideias.sixback.enums.StatusVinculoEmpresaEnum;
+import br.com.seteideias.sixback.repository.UsuarioEmpresaVinculoRepository;
+import br.com.seteideias.sixback.repository.entity.UsuarioEmpresaVinculoEntity;
+import br.com.seteideias.sixback.service.UsuarioEmpresaVinculoService;
+import br.com.seteideias.sixback.service.ValidadorAcessoEmpresaDoUsuario;
+import org.junit.jupiter.api.Test;
+import org.springframework.web.server.ResponseStatusException;
+import java.util.List;
+import java.util.Optional;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class TipoRecebimentoPermissaoServiceTest {
+    final ValidadorAcessoEmpresaDoUsuario acesso = mock(ValidadorAcessoEmpresaDoUsuario.class, withSettings().mockMaker("mock-maker-subclass"));
+    final UsuarioEmpresaVinculoService vinculos = mock(UsuarioEmpresaVinculoService.class, withSettings().mockMaker("mock-maker-subclass"));
+    final UsuarioEmpresaVinculoRepository repository = mock(UsuarioEmpresaVinculoRepository.class, withSettings().mockMaker("mock-maker-subclass"));
+    final TipoRecebimentoPermissaoService service = new TipoRecebimentoPermissaoService(acesso, vinculos, repository);
+
+    private UsuarioEmpresaVinculoEntity vinculo(PapelVinculoEmpresaEnum papel, List<String> permissoes) {
+        var vinculo = UsuarioEmpresaVinculoEntity.builder().papel(papel)
+                .status(StatusVinculoEmpresaEnum.ATIVO).permissoes(permissoes).build();
+        when(acesso.possuiVinculoComEmpresa("usuario", "empresa")).thenReturn(true);
+        when(repository.findByKeycloakIdAndIdUnicoDaEmpresa("usuario", "empresa")).thenReturn(Optional.of(vinculo));
+        when(vinculos.buscarVinculoAtivo("usuario", "empresa")).thenReturn(Optional.of(vinculo));
+        return vinculo;
+    }
+
+    @Test void colaboradorSemConfiguracaoPodeEditarPorPadrao() {
+        vinculo(PapelVinculoEmpresaEnum.COLABORADOR, null);
+        assertTrue(service.podeEditar("usuario", "empresa"));
+    }
+    @Test void colaboradorComPermissoesLegadasContinuaLiberado() {
+        vinculo(PapelVinculoEmpresaEnum.COLABORADOR, List.of("VENDAS_CONSULTAR"));
+        assertTrue(service.podeEditar("usuario", "empresa"));
+    }
+    @Test void negativaExplicitaBloqueiaColaborador() {
+        vinculo(PapelVinculoEmpresaEnum.COLABORADOR, List.of(" tipos_recebimento_editar_negado "));
+        assertFalse(service.podeEditar("usuario", "empresa"));
+        assertEquals(403, assertThrows(ResponseStatusException.class,
+                () -> service.validarEdicao("usuario", "empresa")).getStatusCode().value());
+    }
+    @Test void administradorNaoPodeSerBloqueadoPelaPermissao() {
+        vinculo(PapelVinculoEmpresaEnum.ADMINISTRADOR, List.of(TipoRecebimentoPermissaoService.BLOQUEAR_EDICAO));
+        assertTrue(service.podeEditar("usuario", "empresa"));
+    }
+    @Test void outraEmpresaNaoHerdaPermissao() {
+        vinculo(PapelVinculoEmpresaEnum.ADMINISTRADOR, List.of());
+        assertFalse(service.podeEditar("usuario", "outraEmpresa"));
+    }
+    @Test void vinculoInativoNaoUsaFallbackLegado() {
+        var v = vinculo(PapelVinculoEmpresaEnum.COLABORADOR, List.of());
+        v.setStatus(StatusVinculoEmpresaEnum.PENDENTE);
+        assertFalse(service.podeEditar("usuario", "empresa"));
+        verifyNoInteractions(acesso);
+    }
+}
