{
  "installCommand": "bash install_flutter.sh",
  "buildCommand": "export PATH=\"$PWD/flutter/bin:$PATH\" && flutter --version && flutter pub get && flutter gen-l10n && flutter build web --release",
  "outputDirectory": "build/web",
  "rewrites": [
    {
      "source": "/atendimento/status",
      "destination": "https://api.sixappback.com/atendimento/status"
    },
    {
      "source": "/atendimento/status/assinatura",
      "destination": "https://api.sixappback.com/atendimento/status/assinatura"
    },
    {
      "source": "/public/status/:path*",
      "destination": "https://api.sixappback.com/public/status/:path*"
    },
    {
      "source": "/((?!.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
